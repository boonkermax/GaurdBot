# copy to .env on the VPS and fill in – never commit the real .env
BOT_TOKEN=123456:your-bot-token
DEV_IDS=123456789
# optional: channel where the bot logs added/removed chats, removals and raids (add the bot there as admin)
LOG_CHANNEL_ID=
# optional: free key from sightengine.com (Porn Block + Violence Filter)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# optional: shown to users who need premium, e.g. @yourusername
PREMIUM_CONTACT=
# optional tuning
TRIAL_DAYS=7
MAX_CLONES=10
SCAN_DAILY_LIMIT=450
SCAN_MONTHLY_LIMIT=1900
